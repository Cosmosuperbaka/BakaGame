{
  "name": "bakagame-server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:music:real": "bun test ./integration/netease-music-provider.integration.ts",
    "test:music:login": "bun test ./integration/netease-login.integration.ts",
    "test:coverage": "bun test --coverage",
    "verify": "bun run check && bun run test:coverage",
    "docs:openapi": "bun run src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@neteasecloudmusicapienhanced/api": "4.40.0",
    "bun": "1.3.14",
    "elysia": "^1.2.10"
  },
  "devDependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "bun-types": "^1.2.2",
    "typescript": "^5.9.3"
  }
}
