{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/Index.ts",
    "start": "bun run src/Index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "db:generate": "drizzle-kit generate",
    "db:import-word-bank": "bun run scripts/ImportWordBank.ts",
    "test": "bun test",
    "test:music:real": "bun test ./integration/NeteaseMusicProvider.integration.ts",
    "test:music:login": "bun test ./integration/NeteaseLogin.integration.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/CheckCoverage.ts",
    "test:production-smoke": "bun run scripts/ProductionSmoke.ts",
    "verify": "bun run lint && bun run check && bun run test:coverage",
    "test:grafana": "bun run src/scripts/TestGrafana.ts",
    "docs:openapi": "bun run src/scripts/ExportOpenapi.ts"
  },
  "dependencies": {
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@better-auth/passkey": "1.7.7",
    "@elysiajs/cors": "^1.4.2",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@orpc/contract": "1.15.6",
    "@orpc/server": "1.15.6",
    "@sentry/bun": "^10.75.1",
    "@sinclair/typebox": "^0.34.52",
    "@xmldom/xmldom": "^0.9.12",
    "better-auth": "1.7.7",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "fast-json-patch": "^3.1.1",
    "lru-cache": "^11.5.3",
    "meilisearch": "0.62.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.1.0",
    "p-queue": "^9.3.3",
    "qqmusic-api-enhanced": "^1.0.5",
    "sharp": "^0.35.4",
    "socket.io-client": "^4.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/nodemailer": "8.0.2",
    "bun": "1.4.2",
    "bun-types": "^1.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "picomatch": "^4.0.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.70.1"
  }
}
