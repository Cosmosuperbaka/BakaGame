# 由 Server/src/config/env/Registry.ts 生成（bun run docs:env）；不要手改本文件。
# 变量名、分层、缺省与校验的唯一来源都在代码里，判据见 Agents/Conventions.md §5。
# 真实凭据、私有域名与生产配置一律不进被追踪文件：示例值只用 example.com 之类的虚构占位符。

# ==================== 进程拓扑（改了必须重启） ====================

# 前端可信来源（逗号分隔列表），同时是 CORS 与 WebSocket 的准入名单；留空取本地缺省。
# 链路是同源还是跨域属部署口径，见 Agents/Deployment.md §3。
CLIENT_URL=http://localhost:5173
# 本服务对外基址；缺省取回环加 SERVER_PORT。
SERVER_URL=http://localhost:4850
# 监听端口，1~65535 之外直接拒绝启动。
SERVER_PORT=4850
# 监听网卡，缺省为全网卡。它不是防火墙：公网入口收口靠部署侧的网络访问控制与端口发布范围，见 Agents/Deployment.md §1。
SERVER_LISTEN_HOST=
# 部署环境标记（production / development）：显式设为 production 时启动强制要求 MEILISEARCH_KEY，
# 否则服务拒绝启动；未设置时按 NODE_ENV → development 解析。搜索服务未就绪前勿设 production。
DEPLOYMENT_ENVIRONMENT=
# 通行密钥（WebAuthn）的 relying party 域名：留空取 CLIENT_URL 首个来源的 hostname。
# 只填裸域名（如 example.com，不带协议与端口）。已有用户注册过密钥后**不得再改**：
# 域名写在凭据里，改了等于旧密钥全部失效。多个前端域名要共用密钥时才需要显式配置。
PASSKEY_RP_ID=
# 入站事件放行的项目号；留空时从 SENTRY_DSN 推导。
SENTRY_ALLOWED_PROJECT_IDS=0000000
# 本进程负责的游戏（逗号分隔，可选 faker/song/cee）：只有这些游戏的房间快照会被保存与恢复。
# 留空 = 全部负责，单进程部署就是这种情形；多进程共用代码目录时必须显式区分，
# 否则只接一款流量的进程会把别的游戏的房间一并恢复成无人可连的影子房间。
# 写错名字拒绝启动 —— 静默回落会让这条防线失效。
SHARD_GAMES=faker,song

# ==================== 引导与凭据（缺失即安全失败，不可热更） ====================

# 数据库连接串（MySQL 协议），必须带库名；生产必填，留空则账号、云同步、后台与对局记录关闭。
DATABASE_URL=mysql://user:password@db.example.com:4000/example
# 账号会话签名密钥：配置 DATABASE_URL 时必填，至少 32 字符（openssl rand -hex 32）；更换会使全部登录失效。
BETTER_AUTH_SECRET=
# 管理员 QQ 号（逗号分隔）：建号即为管理员，启动时提升已注册账号；只提升不降级。
ADMIN_QQ=
# 登录验证码发信（生产必填）。主机与端口按所用邮箱服务商填写。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# SMTP_PASS 为该邮箱的客户端专用密码；与 HOST、USER 必须成套，缺一个即拒绝启动。
SMTP_PASS=
# 发件人显示，如 Example <noreply@example.com>；缺省为 SMTP_USER。
MAIL_FROM=
# QQ 昵称来源（OneBot 11 HTTP）；与访问令牌成套，不配则昵称查询整体停用。
QQ_NAPCAT_API_URL=
# 部署停机预告令牌：部署流水线以 Bearer 鉴权调用停机通知端点。
# 任意随机串（如 openssl rand -hex 32 生成），trim 后非空且不含换行；缺失将中止部署（安全失败）。
# 必须由实例创建环境注入：重启不更新环境变量，且部署侧不读本文件。
MAINTENANCE_TOKEN=
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
# 管理后台概览代查 Sentry 的只读令牌（org:read、project:read、event:read），可不配
SENTRY_API_TOKEN=
# Better Stack Uptime 只读 API 令牌；不配则公开状态页的外部监测显示未知。
BETTERSTACK_API_KEY=
# 上游组件 → Better Stack monitor ID 的映射（bangumi=<id>,qqmusic=<id>,netease=<id>,qq=<id>）。
# 只影响状态页的上游接口拆分：未列出的组件显示未知，键或 ID 写错会在启动时拒绝。
BETTERSTACK_MONITOR_MAP=bangumi=12345678,qqmusic=23456789,netease=34567890,qq=45678901
# 公开状态页「前端」一格的探测地址；不配则该组件显示未知。
STATUS_FRONTEND_URL=https://example.com/
# OTLP 导出端点；不配则不导出链路。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 搜索服务的 master key（与服务进程的 MEILISEARCH_KEY 一致）；生产环境必填，CEE 与 SonGuessr 共用。
# 搜索服务必须对本进程可达，见下面 MEILISEARCH_URL 的说明。
MEILISEARCH_KEY=
# 原版兼容房密钥；与地址任一留空则不提供兼容入口。
CCB_ORIGINAL_AES_SECRET=

# ==================== 部署期可调（缺省即正确，特殊形态才覆盖） ====================

# 运行日志等级（debug / info / warn / error），缺省 info。
# debug 只进入本地结构化文件，不送 Sentry 与 OTLP；控制台始终不打印 debug。
LOG_LEVEL=info
# 本地 OTel JSONL 日志目录；缺省为 Server/storage/logs，相对路径按 Server 根目录解析。
# 文件名带部署环境，开发与生产不会写进同一个文件；磁盘轮转与清理由部署侧负责。
LOG_DIR=
# 结构化日志中的操作范围：errors（缺省，只记失败与慢操作）或 all（记录每次请求与命令）。
# 控制台不受此项影响，始终不会逐条打印成功操作。
LOG_OPERATIONS=errors
# 控制台颜色：auto（仅 TTY 着色）/ always / never；容器日志建议 auto 或 never。
LOG_CONSOLE_COLOR=auto
# Agent（MCP）接入总开关，缺省关闭；关闭时握手直接拒绝声明为 Agent 的连接，
# 远程 MCP（/api/mcp）与发现文件也会标记为不可用。stdio 进程同样读取本开关。
MCP_ENABLED=false
# MCP Agent 在房间内使用的默认昵称；缺省 BakaAgent。远程端点首次建连也用它。
MCP_AGENT_NAME=BakaAgent
# 图片对外前缀固定为站内图床路径（不可配）；下面这项只决定图床缺图时去哪补，留空 = 只服务已缓存的图。
BANGUMI_IMAGE_SOURCE=
# 多进程分片时只有主片保持可写；其余片设 false 以只读打开数据集，更新器与备份不装配。
BANGUMI_DATASET_WRITER=
# 运行时更新器：缺省只在生产开启，E2E 与本地开发不该打线上上游。
BANGUMI_UPDATER_ENABLED=
# CCB-TagsCI 的角色标签增量地址；不配就不跑增量同步（上游不保证这条产物长期存在）。
BANGUMI_TAG_DIFF_URL=
# 搜索服务地址：未设置时取代码里的回环默认值，要求搜索服务与本进程在同一网络命名空间。
# 搜索服务独立部署时回环地址不可达，必须设为对本进程可达的地址，
# 否则搜索与出题链路初始化失败（不降级）。
MEILISEARCH_URL=
# 桌面安装包公开下载地址（CI 推上去的固定别名）；留空取代码里的发布约定缺省，显式空串 = 该平台不进列表。
CLIENT_PACKAGE_WINDOWS_URL=
CLIENT_PACKAGE_ANDROID_URL=
# 原版兼容房地址；与密钥任一留空则不提供兼容入口。
CCB_ORIGINAL_SERVER_URL=
# HTTP 文档页（/openapi）是否挂载。未设置时按部署环境推导：非生产开启、production 关闭 ——
# 文档页把全部路由与管理端点面列成可直接照打的清单，不该随生产镜像对外提供。
# 契约产物由 Server 的 OpenAPI 导出脚本离线生成，不依赖线上文档。
# 线上排障需要临时看文档时显式设为 true，不必改代码重出镜像。
OPENAPI_ENABLED=
# 仅本地：未配 SMTP 时设 true，把验证码打印到服务日志；生产设置即拒绝启动。
MAIL_DEV_CONSOLE=

# ==================== 运行期旋钮（存 app_setting，环境变量值只是缺省） ====================

# 桌面壳的最低准入版本；空串 = 不设门槛。通道证明协议破坏性变更时必须抬它。
# 这里是缺省值，线上生效值存 app_setting（发版抬门槛不该要求重建容器）。
CLIENT_MIN_DESKTOP_VERSION=
CLIENT_MIN_MOBILE_VERSION=
# 网易云全局解灰（默认开启）：缺省值，线上开关存 app_setting，改动只影响后续请求。
ENABLE_GENERAL_UNBLOCK=true
# QQ 音乐匿名补充检索（默认开启）：没有 QQ 账号的房间用匿名通道补充免费曲；
# 上游限流时可关闭止损，系统连续失败后也会自动熔断。
ENABLE_ANONYMOUS_QQ_SEARCH=true
