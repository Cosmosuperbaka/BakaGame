CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4850
SERVER_PORT=4850
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
SENTRY_ALLOWED_PROJECT_IDS=0000000
BANGUMI_API_URL=https://api.bgm.tv
BANGUMI_IMAGE_URL=
# Bangumi API 回填缓存落点（选填，默认 Server/storage/bangumi-enrichment.sqlite）
BANGUMI_ENRICHMENT_PATH=
# 内部 Meilisearch master key（与服务进程的 MEILISEARCH_KEY 一致）；生产环境必填，CCB 与 SonGuessr 共用。
# Meilisearch 需与本服务共享 127.0.0.1:7700 的网络空间。
MEILISEARCH_KEY=
# 原版兼容房地址与密钥任一留空则不提供兼容入口。
CCB_ORIGINAL_SERVER_URL=
CCB_ORIGINAL_AES_SECRET=
# 网易云音乐全局解灰（默认开启，可选 true/false）
ENABLE_GENERAL_UNBLOCK=true

# 部署停机预告令牌：部署流水线在容器内调用 /api/system/notify-shutdown 时以 Bearer 鉴权。
# 任意随机串（如 openssl rand -hex 32 生成），trim 后非空且不含换行；缺失将中止部署（安全失败）。
# 必须经容器创建环境注入：docker restart 不更新环境，且部署 helper 不读本文件。
MAINTENANCE_TOKEN=

# 部署环境标记（production / development）：显式设为 production 时启动强制要求 MEILISEARCH_KEY，
# 否则服务拒绝启动；未设置时按 NODE_ENV → development 解析。Meilisearch 未就绪前勿设 production。
DEPLOYMENT_ENVIRONMENT=

# 搜索服务地址：未设置时默认 http://127.0.0.1:7700（要求 Meilisearch 与 app 同网络命名空间）。
# Meilisearch 为独立容器时回环地址不可达，必须设为容器可达地址（如 http://<meili 容器名>:7700），
# 否则搜索与出题链路初始化失败（不降级）。
MEILISEARCH_URL=
