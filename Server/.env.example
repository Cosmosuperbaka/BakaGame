CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4850
SERVER_PORT=4850
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
SENTRY_ALLOWED_PROJECT_IDS=0000000
# 发布版本（建议使用 CI 的 git SHA，例如 bakagame-server@abc1234）
BANGUMI_API_URL=https://api.bgm.tv
BANGUMI_IMAGE_URL=
# Bangumi API 回填缓存落点（选填，默认 Server/storage/bangumi-enrichment.sqlite）
BANGUMI_ENRICHMENT_PATH=
# 原版 CCB 服务器地址：兼容房间与角色使用率上报都用它。具体地址属于部署配置，不进仓库；
# 留空即停用这两项能力。
CCB_ORIGINAL_SERVER_URL=
# 网易云音乐全局解灰（默认开启，可选 true/false）
ENABLE_GENERAL_UNBLOCK=true
