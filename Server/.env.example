CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4850
SERVER_PORT=4850
# 监听网卡，缺省 0.0.0.0。它不是防火墙：公网入口收口靠安全组或 compose 的端口发布范围，见 Agents/Deployment.md §1。
SERVER_LISTEN_HOST=
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
SENTRY_ALLOWED_PROJECT_IDS=0000000
# 管理后台概览代查 Sentry 的只读令牌（org:read、project:read、event:read），可不配
SENTRY_API_TOKEN=
BANGUMI_API_URL=https://api.bgm.tv
# 图片对外前缀固定为自建图床 /api/bangumi（不可配）；下面这项只决定图床缺图时去哪补，留空 = 只服务已缓存的图。
BANGUMI_IMAGE_SOURCE=
# Bangumi API 回填缓存落点（选填，默认 Server/storage/bangumi-enrichment.sqlite）
BANGUMI_ENRICHMENT_PATH=
# 内部 Meilisearch master key（与服务进程的 MEILISEARCH_KEY 一致）；生产环境必填，CEE 与 SonGuessr 共用。
# Meilisearch 需与本服务共享 127.0.0.1:7700 的网络空间。
MEILISEARCH_KEY=
# TiDB（MySQL 协议）连接串，必须带库名；生产必填，留空则账号、云同步、后台与对局记录关闭。
DATABASE_URL=mysql://user:password@tidb.example.com:4000/bakagame
# 账号会话签名密钥：配置 DATABASE_URL 时必填，至少 32 字符（openssl rand -hex 32）；更换会使全部登录失效。
BETTER_AUTH_SECRET=
# 登录验证码发信（生产必填）。飞书企业邮箱：smtp.feishu.cn / 465，SMTP_PASS 为邮箱客户端专用密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示，如 BakaGame <noreply@baka.website>；缺省为 SMTP_USER。
MAIL_FROM=
# 仅本地：未配 SMTP 时设 true，把验证码打印到服务日志；生产设置即拒绝启动。
MAIL_DEV_CONSOLE=
# 管理员 QQ 号（逗号分隔）：建号即为管理员，启动时提升已注册账号；只提升不降级。
ADMIN_QQ=
# 通行密钥（WebAuthn）的 relying party 域名：留空取 CLIENT_URL 首个来源的 hostname。
# 只填裸域名（如 baka.website，不带协议与端口）。已有用户注册过密钥后**不得再改**：
# 域名写在凭据里，改了等于旧密钥全部失效。多个前端域名要共用密钥时才需要显式配置。
PASSKEY_RP_ID=
# 原版兼容房地址与密钥任一留空则不提供兼容入口。
CCB_ORIGINAL_SERVER_URL=
CCB_ORIGINAL_AES_SECRET=
# 网易云音乐全局解灰（默认开启，可选 true/false）
ENABLE_GENERAL_UNBLOCK=true

# 部署停机预告令牌：部署流水线在容器内调用 /api/system/notify-shutdown 时以 Bearer 鉴权。
# 任意随机串（如 openssl rand -hex 32 生成），trim 后非空且不含换行；缺失将中止部署（安全失败）。
# 必须经容器创建环境注入：docker restart 不更新环境，且部署 helper 不读本文件。
MAINTENANCE_TOKEN=

# 部署环境标记（production / development）：显式设为 production 时启动强制要求 MEILISEARCH_KEY，
# 否则服务拒绝启动；未设置时按 NODE_ENV → development 解析。Meilisearch 未就绪前勿设 production。
DEPLOYMENT_ENVIRONMENT=

# HTTP 文档页（/openapi）是否挂载。未设置时按部署环境推导：非生产开启、production 关闭 ——
# 文档页把全部路由与管理端点面列成可直接照打的清单，不该随生产镜像对外提供。
# 契约产物由 `bun run src/scripts/ExportOpenapi.ts` 离线生成，不依赖线上文档。
# 线上排障需要临时看文档时显式设为 true，不必改代码重出镜像。
OPENAPI_ENABLED=

# 搜索服务地址：未设置时默认 http://127.0.0.1:7700（要求 Meilisearch 与 app 同网络命名空间）。
# Meilisearch 为独立容器时回环地址不可达，必须设为容器可达地址（如 http://<meili 容器名>:7700），
# 否则搜索与出题链路初始化失败（不降级）。
MEILISEARCH_URL=
