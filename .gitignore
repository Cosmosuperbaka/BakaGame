word-bank.json
bangumi-enrichment.sqlite

# 番剧数据库不进 Git：体积大，随代码分发会吃穿仓库的带宽与存储额度
Server/data/*.sqlite
# 图床缓存（分片 SQLite + 清单）同样是构建产物：体积大且可由数据构建工具重跑。
Server/data/images/
Server/data/*.sqlite.backup
Server/data/*.sqlite.backup-journal
Server/data/tag-diff-state.json

# 运行时存储：房间快照、本地日志与索引库都落在 Server/storage，可由服务重建。
/Server/storage/

# 本地构建工具不进 Git。数据集只在首次部署时构建一次（本地跑），之后由后端
# 自己更新（爬 API + 应用角色标签 diff），CI 不再生产数据 —— 所以
# build_bangumi_db.py 也一并移出：它不是运行时依赖。
# 注意：apply_tag_diff / 刷新标签的**运行时**版本在 Server/src 以 TS 实现，
# 必须随部署走；tools/ 下这些只是本地一次性用的原型。
tools/
/tasks

# 字体子集与上游字体下载缓存：都由 Client/scripts/build-fonts.mjs 在构建期重建。
# 源 TTF 不随仓库分发，缓存可随时删除；站点只分发 woff2 子集。
Client/.cache/
Client/src/assets/fonts/lxgw-wenkai/
Client/src/assets/fonts/lxgw-wenkai.css
Client/src/assets/fonts/lxgw-wenkai.manifest.json
Client/public/assets/fonts/lxgw-wenkai/

# 压测运行产物（逐跳 JSON 与合成 HTML）是本地测量数据，随 HEAD 与机器而变，
# 只作当次交付材料；复现口径见 Agents/Deployment.md §6，不进 Git。
Server/tasks/
/.qoder-credits
/.mimosa
/.qoder
